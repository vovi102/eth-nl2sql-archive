  "working_tree_patch": "diff --git a/scripts/t11a.py b/scripts/t11a.py\nindex 7337ed3..fb78d63 100644\n--- a/scripts/t11a.py\n+++ b/scripts/t11a.py\n@@ -196,25 +196,11 @@ def gpu(home: Path, pins: Path) -> None:\n             smoke = REPORT / f\"{name}-smoke-10.jsonl\"\n             shutil.copy2(path, smoke)\n             cfg.write_json(REPORT / f\"{name}-smoke-manifest.json\", manifest)\n-            from eth_nl2sql.generation.extract import extract_sql\n-            from eth_nl2sql.validation import ValidationError, validate_sql\n+            from eth_nl2sql.generation.smoke import inspect_predictions, require_smoke_pass\n \n-            inspection = []\n-            for row in rows:\n-                sql, format_ok = extract_sql(row[\"raw_output\"])\n-                check = {\"id\": row[\"id\"], \"sql\": sql, \"format_ok\": format_ok,\n-                         \"finish_reason\": row[\"finish_reason\"], \"status\": \"no_sql\"}\n-                if sql:\n-                    try:\n-                        validate_sql(sql)\n-                        check[\"status\"] = \"static_validation_passed\"\n-                    except ValidationError as exc:\n-                        check.update(status=exc.code, error=str(exc))\n-                inspection.append(check)\n-            cfg.write_json(REPORT / f\"{name}-smoke-inspection.json\", {\n-                \"rows\": 10, \"purpose\": \"output/provenance inspection; no EX computed\",\n-                \"cases\": inspection,\n-            })\n+            inspection = inspect_predictions(rows)\n+            cfg.write_json(REPORT / f\"{name}-smoke-inspection.json\", inspection)\n+            require_smoke_pass(inspection)\n             before = cfg.sha256_file(path)\n             cli(f\"smoke-noop-{name}\", \"generate\", \"--config\", name, \"--limit\", \"10\")\n             if cfg.sha256_file(path) != before:\ndiff --git a/src/eth_nl2sql/cli.py b/src/eth_nl2sql/cli.py\nindex ea05d31..396ba99 100644\n--- a/src/eth_nl2sql/cli.py\n+++ b/src/eth_nl2sql/cli.py\n@@ -735,6 +735,15 @@ def cmd_generate(args: argparse.Namespace) -> None:\n         _print({\"config\": args.config, \"seed\": seed, \"generated\": written, \"out\": out_dir})\n \n \n+def cmd_smoke(args: argparse.Namespace) -> None:\n+    from eth_nl2sql.generation.smoke import inspect_predictions, require_smoke_pass\n+\n+    report = inspect_predictions(cfg.read_jsonl(args.predictions))\n+    cfg.write_json(args.out, report)\n+    _print({k: v for k, v in report.items() if k != \"cases\"})\n+    require_smoke_pass(report)\n+\n+\n def cmd_train(args: argparse.Namespace) -> None:\n     from eth_nl2sql.experiments import run_directory, selected_seeds\n     from eth_nl2sql.train_qlora import train, training_inputs\n@@ -1121,6 +1130,10 @@ def main(argv: list[str] | None = None) -> None:\n     command.add_argument(\"--limit\", type=int)\n     command.add_argument(\"--seed\", choices=(\"42\", \"43\", \"44\", \"all\"), default=\"42\")\n \n+    command = add(\"smoke\", cmd_smoke, \"check TVF signatures and compile on empty schema\")\n+    command.add_argument(\"--predictions\", type=Path, required=True)\n+    command.add_argument(\"--out\", type=Path, required=True)\n+\n     command = add(\"train\", cmd_train, \"QLoRA fine-tuning for b3/b3l (GPU)\")\n     command.add_argument(\"--config\", choices=(\"b3\", \"b3l\", \"all\"), required=True)\n     command.add_argument(\"--seed\", choices=(\"42\", \"43\", \"44\", \"all\"), default=\"42\")\n"
